<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.portfolio.portfolio.Mapper.order.OrderMapper">

    <!-- =====================================================
         회원별 미수금 조회 결과 매핑
         ===================================================== -->
    <resultMap id="receivableResultMap"
               type="com.portfolio.portfolio.Vo.order.ReceivableVo">

        <id property="memberId" column="member_id"/>

        <result property="memberName" column="member_name"/>
        <result property="totalCreditAmount" column="total_credit_amount"/>
        <result property="totalPaidAmount" column="total_paid_amount"/>
        <result property="receivableAmount" column="receivable_amount"/>
        <result property="availableCreditAmount" column="available_credit_amount"/>

    </resultMap>

    <!-- =====================================================
         회원별 미수금 조회

         - 외상 주문만 조회
         - 취소된 주문 제외
         - 완료된 입금액만 반영
         - 회원의 모든 배송지 주문 합산
         - 외상 한도: 2,000,000원
         ===================================================== -->
    <select id="selectMemberReceivable"
            parameterType="java.lang.Long"
            resultMap="receivableResultMap">

        WITH order_payment AS (
        SELECT
        o.order_id,
        o.member_id,
        o.total_amount,

        /* 주문별 완료 입금액 */
        COALESCE(
        SUM(p.payment_amount) FILTER (
        WHERE p.payment_status = 'COMPLETED'
        ),
        0
        ) AS paid_amount

        FROM shop_order o

        LEFT JOIN shop_payment p
        ON o.order_id = p.order_id

        WHERE o.payment_type = 'CREDIT'
        AND o.order_status != 'CANCELLED'

        GROUP BY
        o.order_id,
        o.member_id,
        o.total_amount
        ),
        member_receivable AS (
        SELECT
        member_id,

        /* 외상 주문 총금액 */
        SUM(total_amount) AS total_credit_amount,

        /* 완료된 누적 입금액 */
        SUM(paid_amount) AS total_paid_amount,

        /* 현재 미수금 */
        SUM(
        GREATEST(total_amount - paid_amount, 0)
        ) AS receivable_amount

        FROM order_payment

        GROUP BY member_id
        )

        SELECT
        m.member_id,
        m.member_name,

        COALESCE(r.total_credit_amount, 0)
        AS total_credit_amount,

        COALESCE(r.total_paid_amount, 0)
        AS total_paid_amount,

        COALESCE(r.receivable_amount, 0)
        AS receivable_amount,

        /* 외상 주문 가능 잔여 한도 */
        GREATEST(
        2000000 - COALESCE(r.receivable_amount, 0),
        0
        ) AS available_credit_amount

        FROM member m

        LEFT JOIN member_receivable r
        ON m.member_id = r.member_id

        WHERE m.member_id = #{memberId}

    </select>

    <!-- =====================================================
         회원별 주문 내역 결과 매핑
         ===================================================== -->
    <resultMap id="orderHistoryResultMap"
               type="com.portfolio.portfolio.Vo.order.OrderHistoryVo">

        <id property="orderId" column="order_id"/>

        <result property="orderNo" column="order_no"/>
        <result property="memberId" column="member_id"/>
        <result property="addressId" column="address_id"/>
        <result property="addressName" column="address_name"/>
        <result property="orderStatus" column="order_status"/>
        <result property="paymentType" column="payment_type"/>
        <result property="paymentStatus" column="payment_status"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="createdAt" column="created_at"/>

    </resultMap>

    <!-- =====================================================
         회원별 주문 내역 조회

         - 로그인 회원의 주문만 조회
         - 배송지 선택 시 해당 배송지 주문만 조회
         - 최신 주문순 정렬
         - 취소 주문도 주문 이력에 포함
         ===================================================== -->
    <select id="selectMemberOrderHistory"
            resultMap="orderHistoryResultMap">

        SELECT
        o.order_id,
        o.order_no,
        o.member_id,
        o.address_id,
        o.address_name,
        o.order_status,
        o.payment_type,
        o.payment_status,
        o.total_amount,
        o.created_at

        FROM shop_order o

        WHERE o.member_id = #{memberId}

        <if test="addressId != null">
            AND o.address_id = #{addressId}
        </if>

        ORDER BY
        o.created_at DESC,
        o.order_id DESC

    </select>

    <!-- =====================================================
         주문별 상품 상세 조회 결과 매핑
         ===================================================== -->
    <resultMap id="orderItemResultMap"
               type="com.portfolio.portfolio.Vo.order.OrderItemVo">

        <id property="orderItemId" column="order_item_id"/>

        <result property="orderId" column="order_id"/>
        <result property="productId" column="product_id"/>
        <result property="productName" column="product_name"/>
        <result property="unitPrice" column="unit_price"/>
        <result property="quantity" column="quantity"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

    </resultMap>

    <!-- =====================================================
         주문별 상품 상세 조회

         - 로그인 회원이 소유한 주문만 조회
         - 주문번호를 기준으로 주문 상품 조회
         - 주문 상품 등록순 정렬
         - 다른 회원의 주문 상품 조회 방지
         ===================================================== -->
    <select id="selectOrderItems"
            resultMap="orderItemResultMap">

        SELECT
        oi.order_item_id,
        oi.order_id,
        oi.product_id,
        oi.product_name,
        oi.unit_price,
        oi.quantity,
        oi.total_amount,
        oi.created_at,
        oi.updated_at

        FROM shop_order_item oi

        INNER JOIN shop_order o
        ON oi.order_id = o.order_id

        WHERE o.member_id = #{memberId}
        AND o.order_id = #{orderId}

        ORDER BY oi.order_item_id ASC

    </select>

</mapper>
