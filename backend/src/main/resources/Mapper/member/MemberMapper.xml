<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.portfolio.portfolio.Mapper.member.MemberMapper">

    <select id="selectMemberList" resultType="com.portfolio.portfolio.Vo.member.MemberVO">
        SELECT
        id,
        name,
        email,
        created_at AS "createdAt"
        FROM members
        ORDER BY id
    </select>

</mapper>
