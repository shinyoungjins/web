<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.portfolio.portfolio.Mapper.common.SiteMenuMapper">

    <!-- 메뉴 조회 결과 매핑 -->
    <resultMap id="siteMenuResultMap"
               type="com.portfolio.portfolio.Vo.common.SiteMenuVO">

        <id property="menuId" column="menu_id"/>

        <result property="menuName" column="menu_name"/>
        <result property="menuUrl" column="menu_url"/>
        <result property="parentMenuId" column="parent_menu_id"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="useYn" column="use_yn"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

    </resultMap>

    <!-- 사용 중인 메뉴 전체 조회 -->
    <select id="selectSiteMenuList" resultMap="siteMenuResultMap">
        SELECT
            menu_id,
            menu_name,
            menu_url,
            parent_menu_id,
            sort_order,
            use_yn,
            created_at,
            updated_at
        FROM site_menu
        WHERE use_yn = 'Y'
        ORDER BY parent_menu_id NULLS FIRST,
            sort_order ASC,
            menu_id ASC
    </select>

</mapper>
